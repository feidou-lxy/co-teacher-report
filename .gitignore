# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地凭据（后台 x-token 等，绝不入库）
token.txt
*.token
.env

# 本地工作目录 / 临时产物（同事跑 run_all 时生成的中间文件与报告）
workdir/
_skilltest/
*.html
*.xlsx

# 操作手册：只在内部分发，不随仓库公开（含安装命令与凭证说明）
操作手册.html
学情分析_操作手册*.html

# 飞书应用凭证：仓库里只留不含 secret 的 *.template.json，
# 本机 install.sh 生成的 *.json 含明文密钥，绝不入库。
assets/teams/*.json
!assets/teams/*.template.json

# 操作系统 / 编辑器
.DS_Store
Thumbs.db
.vscode/
.idea/

# 本机读图缓存（含学生姓名，绝不入库 / 不分发）
.cache/
